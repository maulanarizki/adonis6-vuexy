    @slot('main')
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card shadow-sm rounded-4 border-0">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
                                <h4 class="fw-bold mb-0">Data Pengguna</h4>
                                <a href="{{ route('users.create') }}" class="btn btn-primary">
                                    <i class="fa fa-plus me-1"></i> Tambah Pengguna
                                </a>
                            </div>

                            <!-- Form Pencarian -->
                            <div class="mb-3">
                                <form action="{{ route('users.index') }}" method="GET">
                                    <div class="input-group">
                                        <input type="text" class="form-control" placeholder="Cari berdasarkan nama, username, atau email..." name="search" value="{{ queryParams.search || '' }}">
                                        <button class="btn btn-outline-secondary" type="submit">Cari</button>
                                    </div>
                                </form>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>
                                            {{-- Link untuk sorting --}}
                                            <a href="{{ route('users.index', { ...queryParams, sortBy: 'full_name', sortOrder: queryParams.sortBy === 'full_name' && queryParams.sortOrder === 'asc' ? 'desc' : 'asc' }) }}">
                                                Full Name
                                                {{-- Tampilkan ikon sort --}}
                                                @if(queryParams.sortBy === 'full_name')
                                                    <i class="fa fa-sort-{{ queryParams.sortOrder === 'asc' ? 'up' : 'down' }}"></i>
                                                @endif
                                            </a>
                                        </th>
                                        <th>
                                             <a href="{{ route('users.index', { ...queryParams, sortBy: 'username', sortOrder: queryParams.sortBy === 'username' && queryParams.sortOrder === 'asc' ? 'desc' : 'asc' }) }}">
                                                Username
                                                 @if(queryParams.sortBy === 'username')
                                                    <i class="fa fa-sort-{{ queryParams.sortOrder === 'asc' ? 'up' : 'down' }}"></i>
                                                @endif
                                            </a>
                                        </th>
                                        <th>Email</th>
                                        <th>
                                             <a href="{{ route('users.index', { ...queryParams, sortBy: 'created_at', sortOrder: queryParams.sortBy === 'created_at' && queryParams.sortOrder === 'asc' ? 'desc' : 'asc' }) }}">
                                                Dibuat
                                                 @if(queryParams.sortBy === 'created_at')
                                                    <i class="fa fa-sort-{{ queryParams.sortOrder === 'asc' ? 'up' : 'down' }}"></i>
                                                @endif
                                            </a>
                                        </th>
                                        <th>Aksi</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {{-- Gunakan users.all() karena users adalah objek paginator --}}
                                    @each(user in users.all())
                                        <tr>
                                        <td>{{ user.id }}</td>
                                        <td>{{ user.fullName }}</td>
                                        <td>{{ user.username }}</td>
                                        <td>{{ user.email }}</td>
                                        <td>{{ user.createdAt.toFormat('dd LLL yyyy HH:mm') }}</td>
                                        <td>
                                            <a href="{{ route('users.show', { id: user.id }) }}" class="btn btn-info btn-sm">Lihat</a>
                                            <a href="{{ route('users.edit', { id: user.id }) }}" class="btn btn-warning btn-sm">Edit</a>
                                            <form action="{{ route('users.destroy', { id: user.id }) + '?_method=DELETE' }}" method="POST" style="display:inline">
                                            {{ csrfField() }}
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Yakin hapus user?')">Hapus</button>
                                            </form>
                                        </td>
                                        </tr>
                                    @else
                                        <tr>
                                            <td colspan="6" class="text-center">Tidak ada data ditemukan.</td>
                                        </tr>
                                    @end
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Navigasi Pagination -->
