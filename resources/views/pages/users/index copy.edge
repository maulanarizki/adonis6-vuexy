@layout.admin()

    @slot('description')
    <title>Daftar User | Your Company Name</title>
    {{-- Ganti CSS DataTables dengan CSS Grid.js --}}
    <link href="https://cdn.jsdelivr.net/npm/gridjs/dist/theme/mermaid.min.css" rel="stylesheet" />
    @endslot

    @slot('main')   
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card shadow-sm rounded-4 border-0">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
                                <h4 class="fw-bold mb-0">Data Pengguna</h4>
                                <a href="{{ route('users.create') }}" class="btn btn-primary">
                                    <i class="fa fa-plus me-1"></i> Tambah Pengguna
                                </a>
                            </div>

                            {{-- Ganti <table> dengan <div> sebagai container --}}
                            <div id="grid-wrapper"></div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    @endslot
@slot('scripts')
    <script src="https://cdn.jsdelivr.net/npm/gridjs/dist/gridjs.umd.js"></script>

    <script type="module">
      const { Grid, html } = gridjs;
      // 1. Definisikan kolom di luar konstruktor Grid
      const gridColumns = [
        { id: 'id', name: 'ID', sort: true },
        { id: 'full_name', name: 'Full Name', sort: true },
        { id: 'username', name: 'Username', sort: true },
        { id: 'email', name: 'Email', sort: true },
        {
          id: 'created_at',
          name: 'Dibuat',
          sort: true,
          formatter: (cell) => new Date(cell).toLocaleDateString('id-ID', {
              year: 'numeric', month: 'long', day: 'numeric'
          })
        },
        {
          id: 'actions',
          name: 'Aksi',
          sort: false,
          formatter: (cell, row) => {
            const userId = row.id;
            const showUrl = `{{ route('users.show', { id: '__ID__' }) }}`.replace('__ID__', userId);
            const editUrl = `{{ route('users.edit', { id: '__ID__' }) }}`.replace('__ID__', userId);
            const deleteUrl = `{{ route('users.destroy', { id: '__ID__' }) }}`.replace('__ID__', userId);

            return html(`
              <div class="d-flex gap-1">
                <a href="${showUrl}" class="btn btn-info btn-sm">Lihat</a>
                <a href="${editUrl}" class="btn btn-warning btn-sm">Edit</a>
                <form action="${deleteUrl}?_method=DELETE" method="POST" onsubmit="return confirm('Yakin hapus user?');">
                  {{ csrfField() }}
                  <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                </form>
              </div>
            `);
          }
        }
      ];

      new Grid({
        
        columns: gridColumns,
        
        // --- PERBAIKAN DI BAWAH INI ---
        search: {
          server: {
            url: (prev, keyword) => {
              const separator = prev.includes('?') ? '&' : '?';
              // Hapus parameter search & page yang lama agar tidak duplikat
              const newUrl = prev.replace(/([?&])search=[^&]*/g, '').replace(/([?&])page=[^&]*/g, '');
              return `${newUrl}${separator}search=${keyword}`;
            }
          }
        },
        sort: {
          server: {
            url: (prev, columns) => {
              if (!columns.length) return prev;
              
              const sortInfo = columns[0];
              const columnIndex = sortInfo.index;
              
              // 3. Ambil konfigurasi kolom asli menggunakan index
              const columnConfig = gridColumns[columnIndex];
              
              // 4. Pastikan kolom ini bisa di-sort dan memiliki id
              if (!columnConfig || !columnConfig.sort || !columnConfig.id) {
                return prev; // Jangan lakukan apa-apa jika kolom aksi diklik
              }
              
              // 5. Ambil id dari konfigurasi, bukan dari objek sortInfo
              const table_col = columnConfig.id;
              const dir = sortInfo.direction === 1 ? 'asc' : 'desc';

              const separator = prev.includes('?') ? '&' : '?';
              const newUrl = prev.replace(/([?&])sort=[^&]*/g, '').replace(/([?&])direction=[^&]*/g, '');
              return `${newUrl}${separator}sort=${table_col}&direction=${dir}`;
            }
          }
        },
        pagination: {
          enabled: true,
          limit: 10,
          server: {
            url: (prev, page, limit) => {
              const separator = prev.includes('?') ? '&' : '?';
              // Hapus parameter page & limit yang lama agar tidak duplikat
              const newUrl = prev.replace(/([?&])page=[^&]*/g, '').replace(/([?&])limit=[^&]*/g, '');
              return `${newUrl}${separator}page=${page + 1}&limit=${limit}`;
            }
          }
        },
        // --- AKHIR DARI PERBAIKAN ---
        server: {
          url: '{{ route('users.api') }}',
          then: result => result.data.map(user => [
              user.id, user.fullName, user.username, user.email, user.createdAt, null
          ]),
          total: result => result.total
        },
        language: {
          'search': { 'placeholder': '🔍 Ketik untuk mencari...' },
          'pagination': {
            'previous': '⬅️', 'next': '➡️', 'showing': 'Menampilkan', 'results': () => 'hasil', 'to': 'dari', 'of': 'total'
          },
          'loading': 'Memuat...', 'noRecordsFound': 'Tidak ada data ditemukan',
        }
      }).render(document.getElementById('grid-wrapper'));
    </script>
@endslot

@end