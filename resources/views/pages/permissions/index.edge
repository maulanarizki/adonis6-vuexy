@layout.admin()

@slot('description')
<title>Daftar Permission | Your Company Name</title>
<link href="https://cdn.jsdelivr.net/npm/gridjs/dist/theme/mermaid.min.css" rel="stylesheet" />
{{-- SweetAlert2 CSS --}}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<style>
  /* Styling untuk pesan error validasi */
  .invalid-feedback {
    display: block;
    width: 100%;
    margin-top: .25rem;
    font-size: .875em;
    color: #dc3545;
  }
  .is-invalid {
    border-color: #dc3545 !important;
  }
</style>
@endslot

@slot('main')
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow-sm rounded-4 border-0">
                    <div class="card-body">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
                            <h4 class="fw-bold mb-0">Data Permission</h4>
                            {{-- Tombol ini akan memicu modal --}}
                            <button id="btn-add-permission" class="btn btn-primary">
                                <i class="fa fa-plus me-1"></i> Tambah Permission
                            </button>
                        </div>
                        <div id="grid-wrapper"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{-- MODAL UNTUK CREATE DAN UPDATE PERMISSION --}}
    <div class="modal fade" id="permissionModal" tabindex="-1" aria-labelledby="permissionModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="permissionModalLabel">Form Permission</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="permission-form">
                    <div class="modal-body">
                        <input type="hidden" id="permission-id" name="id">

                        <div class="mb-3">
                            <label for="name" class="form-label">Nama Permission</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                            <div class="invalid-feedback" id="name-error"></div>
                            <small class="form-text text-muted">Contoh: `create_user`, `delete_post`</small>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Deskripsi</label>
                            <input type="text" class="form-control" id="description" name="description">
                             <div class="invalid-feedback" id="description-error"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                        <button type="submit" class="btn btn-primary" id="btn-submit">Simpan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
@endslot

@slot('scripts')
<script src="https://cdn.jsdelivr.net/npm/gridjs/dist/gridjs.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script type="module">
  const { Grid, html } = gridjs;

  // Helper Notifikasi
  const Toast = Swal.mixin({
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true,
      didOpen: (toast) => {
          toast.addEventListener('mouseenter', Swal.stopTimer)
          toast.addEventListener('mouseleave', Swal.resumeTimer)
      }
  });

  // Helper CSRF Token
  const getCsrfToken = () => document.querySelector('meta[name="csrf-token"]').getAttribute('content');

  const gridColumns = [
      { id: 'id', name: 'ID', sort: true },
      { id: 'name', name: 'Nama', sort: true },
      { id: 'description', name: 'Deskripsi', sort: true },
      {
          name: 'Aksi',
          sort: false,
          formatter: (cell, row) => {
            const permissionId = row.cells[0].data;
            return html(`
              <div class="d-flex gap-1">
                <button class="btn btn-warning btn-sm btn-edit" data-id="${permissionId}">Edit</button>
                <button class="btn btn-danger btn-sm btn-delete" data-id="${permissionId}">Hapus</button>
              </div>
            `);
          }
      }
  ];

  const grid = new Grid({
    columns: gridColumns,
    server: {
      url: '{{ route('permissions.api') }}',
      then: result => result.data,
      total: result => result.total
    },
    search: { server: { url: (prev, keyword) => `${prev}?search=${keyword}` }},
    sort: {
      server: {
        url: (prev, columns) => {
          if (!columns.length) return prev;
          const sortInfo = columns[0];
          const columnId = gridColumns[sortInfo.index].id;
          if (!columnId) return prev;
          const dir = sortInfo.direction === 1 ? 'asc' : 'desc';
          const separator = prev.includes('?') ? '&' : '?';
          return `${prev}${separator}sort=${columnId}&direction=${dir}`;
        }
      }
    },
    pagination: { enabled: true, limit: 10, server: true },
    language: {
      search: { placeholder: '🔍 Ketik untuk mencari...' },
      pagination: {
        previous: '⬅️', next: '➡️', showing: 'Menampilkan', results: () => 'hasil', to: 'dari', of: 'total'
      },
      loading: 'Memuat...', noRecordsFound: 'Tidak ada data ditemukan',
    }
  });

  grid.render(document.getElementById('grid-wrapper'));

  // ===============================================
  // LOGIKA MODAL & FORM 
  // ===============================================
  const permissionModalEl = document.getElementById('permissionModal');
  const permissionModal = new bootstrap.Modal(permissionModalEl);
  const form = document.getElementById('permission-form');
  const modalLabel = document.getElementById('permissionModalLabel');
  const btnSubmit = document.getElementById('btn-submit');

  const showUrlTemplate = `{{ route('permissions.show', { id: '__ID__' }) }}`;
  const updateUrlTemplate = `{{ route('permissions.update', { id: '__ID__' }) }}`;
  const destroyUrlTemplate = `{{ route('permissions.destroy', { id: '__ID__' }) }}`;

  const clearForm = () => {
    form.reset();
    document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    document.querySelectorAll('.invalid-feedback').forEach(el => el.textContent = '');
  };

  const displayErrors = (errors) => {
    clearForm();
    for (const error of errors) {
      const field = error.field;
      const input = document.getElementById(field);
      const errorDiv = document.getElementById(`${field}-error`);
      if(input && errorDiv) {
          input.classList.add('is-invalid');
          errorDiv.textContent = error.message;
      }
    }
  };

  // Event untuk tombol "Tambah Permission"
  document.getElementById('btn-add-permission').addEventListener('click', () => {
    clearForm();
    modalLabel.textContent = 'Tambah Permission Baru';
    form.action = '{{ route('permissions.store') }}';
    permissionModal.show();
  });

  // Event delegation untuk tombol Edit dan Hapus
  document.getElementById('grid-wrapper').addEventListener('click', async (e) => {
      const target = e.target;
      if (target.classList.contains('btn-edit')) {
          const permissionId = target.dataset.id;
          clearForm();
          modalLabel.textContent = 'Edit Permission';
          form.action = updateUrlTemplate.replace('__ID__', permissionId);
          
          const response = await fetch(showUrlTemplate.replace('__ID__', permissionId));
          const result = await response.json();

          if (result.success) {
              const perm = result.data;
              document.getElementById('permission-id').value = perm.id;
              document.getElementById('name').value = perm.name || '';
              document.getElementById('description').value = perm.description || '';
              permissionModal.show();
          } else {
              Toast.fire({ icon: 'error', title: result.message });
          }
      }

      if (target.classList.contains('btn-delete')) {
          const permissionId = target.dataset.id;
          Swal.fire({
              title: 'Apakah Anda yakin?',
              text: "Data permission akan dihapus secara permanen!",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#d33',
              cancelButtonColor: '#3085d6',
              confirmButtonText: 'Ya, hapus!',
              cancelButtonText: 'Batal'
          }).then(async (result) => {
              if (result.isConfirmed) {
                  const url = destroyUrlTemplate.replace('__ID__', permissionId);
                  const response = await fetch(url, {
                      method: 'DELETE',
                      headers: { 'X-CSRF-TOKEN': getCsrfToken() }
                  });
                  const resData = await response.json();
                  if (resData.success) {
                      Toast.fire({ icon: 'success', title: resData.message });
                      grid.forceRender();
                  } else {
                      Toast.fire({ icon: 'error', title: resData.message });
                  }
              }
          })
      }
  });

  // Event submit form
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btnSubmit.disabled = true;
    btnSubmit.innerHTML = `<span class="spinner-border spinner-border-sm"></span> Menyimpan...`;

    const formData = new FormData(form);
    const isEdit = !!document.getElementById('permission-id').value;
    const method = isEdit ? 'POST' : 'POST';
    if(isEdit) formData.append('_method', 'PUT');

    const response = await fetch(form.action, {
        method: method,
        headers: { 'Accept': 'application/json', 'X-CSRF-TOKEN': getCsrfToken() },
        body: formData
    });

    const result = await response.json();
    btnSubmit.disabled = false;
    btnSubmit.innerHTML = 'Simpan';

    if (response.ok) {
        permissionModal.hide();
        Toast.fire({ icon: 'success', title: result.message });
        grid.forceRender();
    } else if (response.status === 422) {
        displayErrors(result.errors);
    } else {
        Toast.fire({ icon: 'error', title: result.message || 'Terjadi kesalahan.' });
    }
  });

</script>
@endslot

@end